{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/b4moss/janitor/schema/config.schema.json",
  "title": "janitor config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "config format version"
    },
    "targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": ["node_modules", "vendor", ".venv", "venv", "env"],
      "description": "Directory basenames to find and clean"
    },
    "ignore": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": [],
      "description": "ERE patterns matched against the full found path (same as --ignore)"
    },
    "trash_dir": {
      "type": ["string", "null"],
      "default": null,
      "description": "Trash directory; null uses OS default. JANITOR_TRASH_DIR overrides this."
    },
    "default_action": {
      "type": "string",
      "enum": ["trash", "force"],
      "default": "trash",
      "description": "Default disposition when --force is not passed"
    },
    "confirm": {
      "type": "boolean",
      "default": true,
      "description": "Ask before acting; false skips the prompt (non-interactive)"
    }
  },
  "required": ["version"]
}
